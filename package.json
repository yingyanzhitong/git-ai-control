{
  "name": "git-ai-control",
  "version": "0.4.13",
  "description": "Git AI 本地配置与上传隐私控制面板",
  "type": "module",
  "bin": {
    "git-ai-control": "bin/git-ai-control.js"
  },
  "files": [
