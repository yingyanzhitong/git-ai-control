{
  "version": 2,
  "git_ai_enabled": true,
  "default_allow_unmatched": true,
  "skill_policy": {
    "installed": true,
    "enabled": true,
    "blocked_patterns": [
      "godot",
      "\\bgame\\b",
      "game-",
      "-game",
      "game_studio",
      "phaser",
      "three",
      "webgl",
      "unity",
      "unreal",
      "tactics",
      "sprite",
      "github",
      "git-hub",
      "cloudflare",
      "cloud-flare"
    ]
  },
  "plugins": [
    {
      "id": "github",
      "name": "GitHub 仓库",
      "enabled": true,
      "priority": 100,
      "match": {
        "all_repositories": false,
        "hosts": ["github.com"],
        "repositories": [],
        "directories": [],
        "branches": []
      },
      "fixed_project_directory": "",
      "allow": {
        "agent": false,
        "checkpoint": false,
        "commit": false,
        "prompt_duration": false,
        "prompt_report": false,
        "skill": false,
        "token": true
      },
      "fields": {
        "branch": false,
        "path": false,
        "repository": false
      }
    }
  ],
  "plugin_order": [
    "repository:github",
    "skill_filter"
  ],
  "sensitive_data_policy": {
    "installed": false,
    "enabled": false,
    "action": "redact",
    "event_types": {
      "agent": true,
      "checkpoint": true,
      "commit": true,
      "prompt_duration": true,
      "prompt_report": true,
      "skill": true,
      "token": true
    },
    "built_in_rules": {
      "api_key": true,
      "credential": true,
      "email": false,
      "phone": false,
      "private_key": true
    },
    "custom_patterns": []
  },
  "agent_model_policy": {
    "installed": false,
    "enabled": false,
    "mode": "audit",
    "allowed_agents": [],
    "allowed_models": [],
    "blocked_patterns": []
  }
}
